# Copy to .env and adjust before `docker compose up`.

# Pull the published image, or build locally with `docker compose up --build`.
GOMTA_IMAGE=ferchd/gomta:latest

GOMTA_HOSTNAME=mail.example.com
GOMTA_DOMAINS=example.com

# Set a real password before exposing the submission listener.
GOMTA_ADMIN_USER=postmaster@example.com
GOMTA_ADMIN_PASSWORD=

GOMTA_DKIM_SELECTOR=default
GOMTA_DKIM_BITS=2048

# Host-side ports.
GOMTA_SMTP_PORT=2525
GOMTA_SUBMISSION_PORT=5587
GOMTA_STATUS_PORT=8080
